# Generate a long random value. Never prefix this with VITE_.
IDENTITY_HMAC_SECRET=replace-with-a-long-random-secret

# Optional: mTLS-capable backend for stronger Apps-in-Toss key validation.
TOSS_IDENTITY_VERIFY_URL=https://your-backend.example.com/verify/toss-anonymous
TOSS_IDENTITY_VERIFY_SECRET=replace-with-service-to-service-secret
